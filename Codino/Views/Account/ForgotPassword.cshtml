@{
    ViewData["Title"] = "فراموشی رمز عبور";
}

<link rel="stylesheet"
      href="~/css/account.css"
      asp-append-version="true" />

<div class="account-page">

    <div class="account-card">

        <!-- =====================================================
         LOGO
    ====================================================== -->

        <div class="account-logo">

            <img src="~/images/codino-intro.jpg"
                 alt="Codino"
                 loading="eager" />

            <span>
                Codino
            </span>

        </div>


        <!-- =====================================================
         TITLE
    ====================================================== -->

        <h1>
            فراموشی رمز عبور
        </h1>

        <p class="account-description">
            شماره موبایل، کد امنیتی و کپچا را وارد کنید.
        </p>


        <!-- =====================================================
         ERROR
    ====================================================== -->
        @if (ViewBag.Error != null)
        {
            <div class="account-error"
                 role="alert">

                @ViewBag.Error

            </div>
        }


        <!-- =====================================================
         FORGOT PASSWORD FORM
    ====================================================== -->

        <form asp-controller="Account"
              asp-action="ForgotPassword"
              method="post"
              autocomplete="off">

            @Html.AntiForgeryToken()


            <!-- =================================================
             PHONE NUMBER
        ================================================== -->

            <div class="input-group">

                <label for="phoneNumber">
                    شماره موبایل
                </label>

                <input type="tel"
                       id="phoneNumber"
                       name="phoneNumber"
                       maxlength="11"
                       minlength="11"
                       inputmode="numeric"
                       autocomplete="tel"
                       placeholder="09123456789"
                       value="@ViewBag.PhoneNumber"
                       required />

            </div>


            <!-- =================================================
             SECURITY CODE
        ================================================== -->

            <div class="input-group">

                <label for="securityCode">
                    کد امنیتی ۴ رقمی
                </label>

                <input type="text"
                       id="securityCode"
                       name="securityCode"
                       maxlength="4"
                       minlength="4"
                       inputmode="numeric"
                       pattern="[0-9]{4}"
                       autocomplete="off"
                       placeholder="مثلاً 4821"
                       required />

                <small style="
                    display:block;
                    margin-top:8px;
                    color:#9ca3af;
                    line-height:1.8;
                    ">

                    یکی از دو کد امنیتی که هنگام ثبت‌نام دریافت کردید
                    را وارد کنید.

                </small>

            </div>


            <!-- =================================================
             CAPTCHA
        ================================================== -->

            <div class="input-group">

                <label for="captcha">
                    کد امنیتی تصویر
                </label>


                @if (!string.IsNullOrWhiteSpace(
                        ViewBag.CaptchaImage as string))
                {
                    <div style="
                        margin-bottom:12px;
                        background:#111827;
                        border:1px solid #374151;
                        border-radius:12px;
                        padding:10px;
                        text-align:center;
                        ">

                        <img src="data:image/svg+xml;base64,@ViewBag.CaptchaImage"
                             alt="Captcha"
                             style="
                        width:240px;
                        max-width:100%;
                        height:auto;
                        display:block;
                        margin:auto;
                        " />

                    </div>
                }


                <input type="hidden"
                       name="captchaId"
                       value="@ViewBag.CaptchaId" />


                <input type="text"
                       id="captcha"
                       name="captcha"
                       maxlength="6"
                       inputmode="text"
                       autocomplete="off"
                       autocapitalize="characters"
                       spellcheck="false"
                       placeholder="کد داخل تصویر را وارد کنید"
                       required />

            </div>


            <!-- =================================================
             SUBMIT
        ================================================== -->

            <button type="submit"
                    class="account-button">

                ادامه

            </button>

        </form>


        <!-- =====================================================
         FOOTER
    ====================================================== -->

        <div class="account-footer">

            رمز عبور را به یاد آوردید؟

            <a asp-controller="Account"
               asp-action="Login">

                ورود

            </a>

        </div>

    </div>

</div>

<!-- =========================================================
     JAVASCRIPT
========================================================== -->

<script>

    document.addEventListener(
        "DOMContentLoaded",
        function() {

            // =================================================
            // PHONE NUMBER
            // =================================================

            const phoneInput =
                document.getElementById("phoneNumber");

            if (phoneInput) {

                phoneInput.addEventListener(
                    "input",
                    function() {

                        this.value =
                            this.value.replace(/\D/g, "");

                    });

            }


            // =================================================
            // SECURITY CODE
            // فقط ۴ رقم
            // =================================================

            const securityCodeInput =
                document.getElementById("securityCode");

            if (securityCodeInput) {

                securityCodeInput.addEventListener(
                    "input",
                    function() {

                        this.value =
                            this.value
                                .replace(/\D/g, "")
                                .slice(0, 4);

                    });

            }


            // =================================================
            // CAPTCHA
            // =================================================

            const captchaInput =
                document.getElementById("captcha");

            if (captchaInput) {

                captchaInput.addEventListener(
                    "input",
                    function() {

                        this.value =
                            this.value
                                .replace(/\s/g, "")
                                .toUpperCase();

                    });

            }

        });

</script>
