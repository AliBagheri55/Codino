@{
    ViewData["Title"] = "فراموشی رمز عبور";
}

<link rel="stylesheet"
      href="~/css/account.css"
      asp-append-version="true" />

<div class="account-page">

    <div class="account-card">

        <div class="account-logo">

            <img src="~/images/codino-intro.jpg"
                 alt="Codino" />

            <span>
                Codino
            </span>

        </div>

        <h1>
            فراموشی رمز عبور
        </h1>

        <p class="account-description">
            شماره موبایل خود را وارد کنید و کپچا را حل کنید.
        </p>

        @if (ViewBag.Error != null)
        {
            <div class="account-error">
                @ViewBag.Error
            </div>
        }

        <form asp-controller="Account"
              asp-action="ForgotPassword"
              method="post"
              autocomplete="off">

            @Html.AntiForgeryToken()

            <div class="input-group">

                <label for="phoneNumber">
                    شماره موبایل
                </label>

                <input type="tel"
                       id="phoneNumber"
                       name="phoneNumber"
                       maxlength="11"
                       minlength="11"
                       inputmode="numeric"
                       autocomplete="tel"
                       placeholder="09123456789"
                       required />

            </div>

            <div class="input-group">

                <label>
                    کد امنیتی
                </label>

                @if (!string.IsNullOrWhiteSpace(
                        ViewBag.CaptchaImage as string))
                {
                    <div style="
                        margin-bottom:12px;
                        background:#111827;
                        border:1px solid #374151;
                        border-radius:12px;
                        padding:10px;
                        text-align:center;
                        ">

                        <img src="data:image/svg+xml;base64,@ViewBag.CaptchaImage"
                             alt="Captcha"
                             style="
                        width:240px;
                        max-width:100%;
                        height:auto;
                        display:block;
                        margin:auto;
                        " />

                    </div>
                }

                <input type="hidden"
                       name="captchaId"
                       value="@ViewBag.CaptchaId" />

                <input type="text"
                       id="captcha"
                       name="captcha"
                       maxlength="6"
                       autocomplete="off"
                       placeholder="کد داخل تصویر را وارد کنید"
                       required />

            </div>

            <button type="submit"
                    class="account-button">

                ادامه

            </button>

        </form>

        <div class="account-footer">

            رمز عبور را به یاد آوردید؟

            <a asp-controller="Account"
               asp-action="Login">

                ورود

            </a>

        </div>

    </div>

</div>