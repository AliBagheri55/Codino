@{
    ViewData["Title"] = "ورود به حساب";
}

<link rel="stylesheet"
      href="~/css/account.css"
      asp-append-version="true" />

<div class="account-page">

    <div class="account-card">

        <div class="account-logo">

            <img src="~/images/codino-intro.jpg"
                 alt="Codino"
                 loading="eager" />

            <span>
                Codino
            </span>

        </div>


        <h1>
            ورود به حساب
        </h1>

        <p class="account-description">
            برای ورود، شماره موبایل و رمز عبور خود را وارد کنید.
        </p>

        @if (TempData["AccountSuccess"] != null)
        {
            <div class="account-success"
                 role="alert">

                @TempData["AccountSuccess"]

            </div>
        }

        @if (ViewBag.Error != null)
        {
            <div class="account-error"
                 role="alert">

                @ViewBag.Error

            </div>
        }


        <form asp-controller="Account"
              asp-action="Login"
              method="post"
              autocomplete="on">

            @Html.AntiForgeryToken()

            <div class="input-group">

                <label for="phoneNumber">
                    شماره موبایل
                </label>

                <input type="tel"
                       id="phoneNumber"
                       name="phoneNumber"
                       maxlength="11"
                       minlength="11"
                       inputmode="numeric"
                       autocomplete="tel"
                       placeholder="09123456789"
                       required />

            </div>

            <div class="input-group">

                <label for="password">
                    رمز عبور
                </label>

                <input type="password"
                       id="password"
                       name="password"
                       minlength="8"
                       maxlength="128"
                       autocomplete="current-password"
                       placeholder="رمز عبور"
                       required />

            </div>

            <div class="input-group">

                <label for="captcha">
                    کد امنیتی
                </label>

                <div class="captcha-container">

                    <div id="captchaDisplay"
                         class="captcha-display"
                         aria-label="کد امنیتی">

                        @(ViewBag.Captcha ?? "")

                    </div>


                    <button type="button"
                            class="captcha-refresh"
                            onclick="refreshCaptcha()"
                            title="کپچای جدید"
                            aria-label="تولید کپچای جدید">

                        ↻

                    </button>

                </div>


                <input type="text"
                       id="captcha"
                       name="captcha"
                       maxlength="5"
                       minlength="5"
                       inputmode="text"
                       autocomplete="off"
                       autocapitalize="characters"
                       spellcheck="false"
                       placeholder="کد بالا را وارد کنید"
                       required />

            </div>

            <button type="submit"
                    class="account-button">

                ورود

            </button>

        </form>


        <div class="account-footer">

            <a asp-controller="Account"
               asp-action="ForgotPassword">

                فراموشی رمز عبور

            </a>

        </div>

        <div class="account-footer">

            حساب کاربری ندارید؟

            <a asp-controller="Account"
               asp-action="Register">

                ثبت نام کنید

            </a>

        </div>

    </div>

</div>


<script>


    function refreshCaptcha() {

        window.location.href =
            '@Url.Action("Login", "Account")';

    }


    document.addEventListener(
        "DOMContentLoaded",
        function () {


            const phoneInput =
                document.getElementById("phoneNumber");

            if (phoneInput) {

                phoneInput.addEventListener(
                    "input",
                    function () {

                        this.value =
                            this.value.replace(/\D/g, "");

                    });

            }

            const captchaInput =
                document.getElementById("captcha");

            if (captchaInput) {

                captchaInput.addEventListener(
                    "input",
                    function () {

                        this.value =
                            this.value
                                .replace(/\s/g, "")
                                .toUpperCase();

                    });

            }

        });

</script>