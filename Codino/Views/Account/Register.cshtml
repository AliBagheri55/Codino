@{
    ViewData["Title"] = "ثبت نام";
}

<link rel="stylesheet"
      href="~/css/account.css"
      asp-append-version="true" />

<div class="account-page">

    <div class="account-card">

        <!-- =====================================================
         LOGO
    ====================================================== -->

        <div class="account-logo">

            <img src="~/images/codino-intro.jpg"
                 alt="Codino"
                 loading="eager" />

            <span>
                Codino
            </span>

        </div>


        <!-- =====================================================
         TITLE
    ====================================================== -->

        <h1>
            ساخت حساب
        </h1>


        <!-- =====================================================
         ERROR
    ====================================================== -->
        @if (ViewBag.Error != null)
        {
            <div class="account-error"
                 role="alert">

                @ViewBag.Error

            </div>
        }


        <!-- =====================================================
         REGISTER FORM
    ====================================================== -->

        <form asp-controller="Account"
              asp-action="Register"
              method="post"
              autocomplete="on">

            @Html.AntiForgeryToken()


            <!-- =================================================
             FULL NAME
        ================================================== -->

            <div class="input-group">

                <label for="fullName">
                    نام و نام خانوادگی
                </label>

                <input type="text"
                       id="fullName"
                       name="fullName"
                       maxlength="100"
                       autocomplete="name"
                       placeholder="مثلاً علی باقری"
                       required />

            </div>


            <!-- =================================================
             PHONE
        ================================================== -->

            <div class="input-group">

                <label for="phoneNumber">
                    شماره موبایل
                </label>

                <input type="tel"
                       id="phoneNumber"
                       name="phoneNumber"
                       placeholder="09123456789"
                       maxlength="11"
                       minlength="11"
                       inputmode="numeric"
                       autocomplete="tel"
                       required />

            </div>


            <!-- =================================================
             PASSWORD
        ================================================== -->

            <div class="input-group">

                <label for="password">
                    رمز عبور
                </label>

                <input type="password"
                       id="password"
                       name="password"
                       placeholder="حداقل ۸ کاراکتر"
                       minlength="8"
                       maxlength="128"
                       autocomplete="new-password"
                       required />

            </div>


            <!-- =================================================
             REPEAT PASSWORD
        ================================================== -->

            <div class="input-group">

                <label for="repeatPassword">
                    تکرار رمز عبور
                </label>

                <input type="password"
                       id="repeatPassword"
                       name="repeatPassword"
                       placeholder="رمز عبور را دوباره وارد کنید"
                       minlength="8"
                       maxlength="128"
                       autocomplete="new-password"
                       required />

            </div>


            <!-- =================================================
             CAPTCHA
        ================================================== -->

            <div class="input-group">

                <label for="captcha">
                    کد امنیتی
                </label>

                <div class="captcha-container">

                    <div id="captchaDisplay"
                         class="captcha-display"
                         aria-label="کد امنیتی">

                        @(ViewBag.Captcha ?? "")

                    </div>


                    <button type="button"
                            class="captcha-refresh"
                            onclick="refreshRegisterCaptcha()"
                            title="کپچای جدید"
                            aria-label="تولید کپچای جدید">

                        ↻

                    </button>

                </div>


                <input type="text"
                       id="captcha"
                       name="captcha"
                       maxlength="5"
                       minlength="5"
                       inputmode="text"
                       autocomplete="off"
                       autocapitalize="characters"
                       spellcheck="false"
                       placeholder="کد بالا را وارد کنید"
                       required />

            </div>


            <!-- =================================================
             REGISTER BUTTON
        ================================================== -->

            <button type="submit"
                    class="account-button">

                ثبت نام

            </button>

        </form>


        <!-- =====================================================
         LOGIN
    ====================================================== -->

        <div class="account-footer">

            حساب کاربری دارید؟

            <a asp-controller="Account"
               asp-action="Login">

                ورود

            </a>

        </div>

    </div>

</div>

<!-- =========================================================
     JAVASCRIPT
========================================================== -->

<script>

    function refreshRegisterCaptcha() {

        window.location.href =
            '@Url.Action("Register", "Account")';

    }


    document.addEventListener(
        "DOMContentLoaded",
        function () {

  
            const captchaInput =
                document.getElementById("captcha");

            if (captchaInput) {

                captchaInput.addEventListener(
                    "input",
                    function () {

                        this.value =
                            this.value
                                .replace(/\s/g, "")
                                .toUpperCase();

                    });

            }

            const phoneInput =
                document.getElementById("phoneNumber");

            if (phoneInput) {

                phoneInput.addEventListener(
                    "input",
                    function () {

                        this.value =
                            this.value.replace(/\D/g, "");

                    });

            }


            const form =
                document.querySelector("form");

            const password =
                document.getElementById("password");

            const repeatPassword =
                document.getElementById("repeatPassword");


            if (!form ||
                !password ||
                !repeatPassword) {

                return;

            }


            form.addEventListener(
                "submit",
                function (event) {

                    if (
                        password.value !==
                        repeatPassword.value
                    ) {

                        event.preventDefault();

                        alert(
                            "رمز عبور و تکرار رمز عبور یکسان نیستند."
                        );

                        repeatPassword.focus();

                    }

                });

        });

</script>