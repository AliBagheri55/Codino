@{
    ViewData["Title"] = "تغییر رمز عبور";
}

<link rel="stylesheet"
      href="~/css/account.css"
      asp-append-version="true" />

<div class="account-page">

    <div class="account-card reset-password-card">


        <div class="account-logo">

            <img src="~/images/codino-intro.jpg"
                 alt="Codino"
                 loading="eager" />

            <span>
                Codino
            </span>

        </div>

        <h1>
            تغییر رمز عبور
        </h1>


        <p class="account-description">

            برای شماره

            <strong>
                @ViewBag.PhoneNumber
            </strong>

            رمز عبور جدید تعیین کنید.

        </p>
        @if (ViewBag.Error != null)
        {
            <div class="account-error"
                 role="alert">

                @ViewBag.Error

            </div>
        }

        <form asp-controller="Account"
              asp-action="ResetPassword"
              method="post"
              autocomplete="off">

            @Html.AntiForgeryToken()
            <input type="hidden"
                   name="phoneNumber"
                   value="@ViewBag.PhoneNumber" />
            <input type="hidden"
                   name="resetToken"
                   value="@ViewBag.ResetToken" />
            <div class="input-group">

                <label for="newPassword">
                    رمز عبور جدید
                </label>

                <input type="password"
                       id="newPassword"
                       name="newPassword"
                       minlength="8"
                       maxlength="128"
                       autocomplete="new-password"
                       placeholder="حداقل ۸ کاراکتر"
                       required />

            </div>
            <div class="input-group">

                <label for="repeatPassword">
                    تکرار رمز عبور
                </label>

                <input type="password"
                       id="repeatPassword"
                       name="repeatPassword"
                       minlength="8"
                       maxlength="128"
                       autocomplete="new-password"
                       placeholder="رمز عبور را دوباره وارد کنید"
                       required />

            </div>

            <button type="submit"
                    class="account-button">

                تغییر رمز عبور

            </button>

        </form>

        <div class="account-footer">

            <a asp-controller="Account"
               asp-action="Login">

                بازگشت به ورود

            </a>

        </div>

    </div>


</div>

<script>

    document.addEventListener(
        "DOMContentLoaded",
        function () {

            const form =
                document.querySelector("form");

            const newPassword =
                document.getElementById("newPassword");

            const repeatPassword =
                document.getElementById("repeatPassword");


            if (!form ||
                !newPassword ||
                !repeatPassword) {

                return;

            }


            form.addEventListener(
                "submit",
                function (event) {

                    if (
                        newPassword.value !==
                        repeatPassword.value
                    ) {

                        event.preventDefault();

                        alert(
                            "رمز عبور جدید و تکرار آن یکسان نیستند."
                        );

                        repeatPassword.focus();

                    }

                });

        });

</script>