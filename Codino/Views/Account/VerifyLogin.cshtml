@{
    ViewData["Title"] = "کد ورود";
}

<link rel="stylesheet"
      href="~/css/account.css"
      asp-append-version="true" />

<div class="account-page">

    <div class="account-card">


        <div class="account-logo">

            <img src="~/images/codino-intro.jpg"
                 alt="Codino"
                 loading="eager" />

            <span>
                Codino
            </span>

        </div>


        <h1>
            تأیید ورود
        </h1>


        <p class="account-description">

            کد ورود برای شماره

            <strong>
                @ViewBag.PhoneNumber
            </strong>

            را وارد کنید.

        </p>


        <div class="test-otp-box">

            <span>
                کد تست ورود
            </span>

            <strong>
                123456
            </strong>

            <small>
                فعلاً پیامک فعال نیست.
            </small>

        </div>

        @if (ViewBag.Error != null)
        {
            <div class="account-error"
                 role="alert">

                @ViewBag.Error

            </div>
        }

        <form method="post"
              action="/Account/VerifyLogin"
              autocomplete="off">

            @Html.AntiForgeryToken()


            <div class="input-group">

                <label for="code">
                    کد ورود
                </label>

                <input type="text"
                       id="code"
                       name="code"
                       maxlength="6"
                       minlength="6"
                       inputmode="numeric"
                       pattern="[0-9]{6}"
                       autocomplete="one-time-code"
                       placeholder="123456"
                       class="otp-input"
                       required />

            </div>


            <button type="submit"
                    class="account-button">

                ورود به Codino

            </button>

        </form>


        <div class="account-footer">

            <a asp-controller="Account"
               asp-action="Login">

                بازگشت به ورود

            </a>

        </div>

    </div>

</div>


<script>

    document.addEventListener("DOMContentLoaded", function () {

        const codeInput =
            document.getElementById("code");


        if (!codeInput) {
            return;
        }


        codeInput.addEventListener("input", function () {

            this.value = this.value
                .replace(/[^0-9]/g, "")
                .slice(0, 6);

        });


        codeInput.addEventListener("paste", function (event) {

            event.preventDefault();


            const clipboard =
                event.clipboardData ||
                window.clipboardData;


            if (!clipboard) {
                return;
            }


            const pastedText =
                clipboard.getData("text");


            const numericCode =
                pastedText
                    .replace(/[^0-9]/g, "")
                    .slice(0, 6);


            this.value = numericCode;


            this.dispatchEvent(
                new Event("input", {
                    bubbles: true
                })
            );

        });


        codeInput.addEventListener("drop", function (event) {

            event.preventDefault();

        });


        codeInput.addEventListener("dragover", function (event) {

            event.preventDefault();

        });

    });

</script>