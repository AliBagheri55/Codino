@{
    ViewData["Title"] = "تأیید شماره موبایل";
}

<link rel="stylesheet"
      href="~/css/account.css"
      asp-append-version="true" />

<div class="account-page">

    <div class="account-card">

        <div class="account-logo">

            <img src="~/images/codino-intro.jpg"
                 alt="Codino"
                 loading="eager" />

            <span>
                Codino
            </span>

        </div>



        <p class="account-description">

            برای شماره

            <strong>
                @ViewBag.PhoneNumber
            </strong>

            یکی از کد امنیتی را وارد کنید.

        </p>

        @if (!string.IsNullOrWhiteSpace(
                    ViewBag.SecurityCode1 as string) &&
                !string.IsNullOrWhiteSpace(
                    ViewBag.SecurityCode2 as string))
        {
            <div class="test-otp-box">

                <span>
                    کدهای امنیتی بازیابی رمز عبور
                </span>

                <div style="
                    display:flex;
                    justify-content:center;
                    gap:20px;
                    margin:15px 0;
                    flex-wrap:wrap;
                    ">

                    <strong style="
                        font-size:28px;
                        letter-spacing:6px;
                        ">

                        @ViewBag.SecurityCode1

                    </strong>

                    <strong style="
                        font-size:28px;
                        letter-spacing:6px;
                        ">

                        @ViewBag.SecurityCode2

                    </strong>

                </div>

                <small>

                    این دو کد را در جای امنی نگهداری کنید.
                    برای بازیابی رمز عبور، استفاده از یکی از این دو کد کافی است.

                </small>

            </div>
        }

        @if (!string.IsNullOrWhiteSpace(
                    ViewBag.Error as string))
        {
            <div class="account-error"
                 role="alert">

                @ViewBag.Error

            </div>
        }


        <form asp-controller="Account"
              asp-action="VerifyRegister"
              method="post"
              autocomplete="off">

            @Html.AntiForgeryToken()


            <div class="input-group">

                <label for="code">
                    کد تأیید ۴ رقمی
                </label>

                <input type="text"
                       id="code"
                       name="code"
                       maxlength="4"
                       minlength="4"
                       inputmode="numeric"
                       pattern="[0-9]{4}"
                       autocomplete="one-time-code"
                       placeholder="مثلاً 4821"
                       class="otp-input"
                       required />

            </div>


            <button type="submit"
                    class="account-button">

                تأیید و ساخت حساب

            </button>

        </form>

        <div class="account-footer">

            <a asp-controller="Account"
               asp-action="Register">

                بازگشت به ثبت نام

            </a>

        </div>

    </div>

</div>


<script>

    document.addEventListener(
        "DOMContentLoaded",
        function() {

            const codeInput =
                document.getElementById("code");

            if (!codeInput) {
                return;
            }


            codeInput.addEventListener(
                "input",
                function() {

                    this.value =
                        this.value
                            .replace(/\D/g, "")
                            .slice(0, 4);

                });

        });

</script>
