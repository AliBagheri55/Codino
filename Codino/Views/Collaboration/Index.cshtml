
@{
    ViewData["Title"] = "همکاری با کدینو";
    Layout = "_Layout";
}

<link rel="stylesheet"
      href="~/css/collaboration.css"
      asp-append-version="true" />

<main class="collaboration-page" dir="rtl">

    <div class="collaboration-container">

        <header class="collaboration-header">

            <span class="header-label">
                فرصت همکاری با کدینو
            </span>

            <h1>آینده‌ای بهتر با همکاری یکدیگر</h1>

            <p>
                ما به دنبال افراد خلاق، باانگیزه و علاقه‌مند به دنیای برنامه‌نویسی هستیم.
                اگر آماده رشد و تجربه پروژه‌های جدید هستید، فرم زیر را تکمیل کنید.
            </p>

        </header>

        <section class="collaboration-card">

            <div class="card-header">

                <h2>اطلاعات درخواست همکاری</h2>

                <p>لطفاً اطلاعات خود را به‌درستی وارد کنید.</p>

            </div>

            <form id="collaborationForm"
                  data-submit-url="@Url.Action("Submit", "Collaboration")"
                  method="post">

                @Html.AntiForgeryToken()

                <div class="form-grid">

                    <div class="form-group">

                        <label for="fullName">
                            نام و نام خانوادگی
                        </label>

                        <input type="text"
                               id="fullName"
                               placeholder="نام کامل خود را وارد کنید"
                               maxlength="100"
                               required>

                    </div>

                    <div class="form-group">

                        <label for="phone">
                            شماره تماس
                        </label>

                        <input type="tel"
                               id="phone"
                               placeholder="09123456789"
                               maxlength="11"
                               required>

                    </div>

                    <div class="form-group">

                        <label for="specialty">
                            حوزه تخصصی
                        </label>

                        <select id="specialty" required>

                            <option value="">
                                انتخاب حوزه تخصصی
                            </option>

                            <option value="Frontend">
                                برنامه‌نویس فرانت‌اند
                            </option>

                            <option value="Backend">
                                برنامه‌نویس بک‌اند
                            </option>

                            <option value="FullStack">
                                برنامه‌نویس فول‌استک
                            </option>

                            <option value="Python">
                                برنامه‌نویس پایتون
                            </option>

                            <option value="Mobile">
                                برنامه‌نویس موبایل
                            </option>

                            <option value="Desktop">
                                برنامه‌نویس دسکتاپ
                            </option>

                            <option value="UIUX">
                                طراح رابط کاربری
                            </option>

                            <option value="AI">
                                هوش مصنوعی
                            </option>

                            <option value="Other">
                                سایر تخصص‌ها
                            </option>

                        </select>

                    </div>

                    <div class="form-group">

                        <label for="experience">
                            سابقه فعالیت
                        </label>

                        <select id="experience" required>

                            <option value="">
                                انتخاب سابقه فعالیت
                            </option>

                            <option value="Beginner">
                                کمتر از یک سال
                            </option>

                            <option value="Junior">
                                ۱ تا ۳ سال
                            </option>

                            <option value="Mid">
                                ۳ تا ۵ سال
                            </option>

                            <option value="Senior">
                                بیشتر از ۵ سال
                            </option>

                        </select>

                    </div>

                    <div class="form-group full-width">

                        <label for="skills">
                            مهارت‌ها و زبان‌های برنامه‌نویسی
                        </label>

                        <input type="text"
                               id="skills"
                               placeholder="مثلاً C#، Python، JavaScript، ASP.NET Core"
                               maxlength="300"
                               required>

                    </div>

                    <div class="form-group full-width">

                        <label for="portfolio">
                            لینک نمونه‌کار یا گیت‌هاب
                        </label>

                        <input type="url"
                               id="portfolio"
                               placeholder="https://github.com/username"
                               maxlength="500">

                    </div>

                    <div class="form-group full-width">

                        <label for="description">
                            معرفی و توضیحات
                        </label>

                        <textarea id="description"
                                  rows="5"
                                  placeholder="درباره خود، توانایی‌ها و انگیزه همکاری‌تان بنویسید..."
                                  maxlength="1500"
                                  required></textarea>

                    </div>

                </div>

                <button type="submit"
                        id="submitButton"
                        class="submit-button">

                    ثبت درخواست همکاری

                </button>

                <p class="form-footer">
                    اطلاعات شما پس از ثبت برای بررسی به تیم کدینو ارسال می‌شود.
                </p>

            </form>

            <div id="successMessage"
                 class="success-message"
                 hidden>

                <h3>
                    درخواست شما با موفقیت ثبت شد
                </h3>

                <p>
                    اطلاعات شما دریافت شد.
                    به‌زودی کارشناس کدینو برای ادامه مراحل همکاری با شما ارتباط خواهد گرفت.
                </p>

                <button type="button" id="newRequestButton">
                    بازگشت به فرم
                </button>

            </div>

        </section>

    </div>

</main>

<script src="~/js/collaboration.js"
        asp-append-version="true"></script>
