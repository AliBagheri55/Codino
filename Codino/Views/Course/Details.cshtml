@model Codino.Models.Api.CourseResponse

@{
    ViewData["Title"] = Model.Title;

    int totalChapters = Model.Chapters;
    int sessionsPerChapter = 10;
}

<div class="container py-5">

    <div class="course-details">

        <img src="@Model.Image"
             alt="@Model.Title"
             class="img-fluid" />

        <h1 class="mt-4">
            @Model.Title
        </h1>

        <p>
            @Model.Description
        </p>

        <div class="course-info">

            <span>
                @Model.Chapters فصل
            </span>

            <span>
                @Model.Sessions جلسه
            </span>

        </div>

        <div class="course-price mt-4">

            @Model.Price.ToString("N0")
            تومان

        </div>


        <!-- =========================
             فصل‌ها و قسمت‌ها
        ========================== -->

        <div class="course-chapters mt-5">

            <h2 class="mb-4">
                سرفصل دوره
            </h2>


            @for (int chapter = 1; chapter <= totalChapters; chapter++)
            {
                <div class="chapter mb-4">

                    <h3 class="chapter-title">
                        فصل @chapter
                    </h3>


                    <div class="lessons">

                        @for (
                            int lesson = 1;
                            lesson <= sessionsPerChapter;
                            lesson++
                        )
                        {
                            int lessonNumber =
                                ((chapter - 1) * sessionsPerChapter)
                                + lesson;

                            <div class="lesson">

                                <span class="lesson-number">
                                    قسمت @lessonNumber
                                </span>

                                <span class="lesson-title">
                                    درس @lesson
                                </span>

                            </div>
                        }

                    </div>

                </div>
            }

        </div>


        <!-- =========================
             بازگشت
        ========================== -->

        <div class="mt-4">

            <a href="/Home/Index"
               class="btn btn-secondary">
                بازگشت به دوره‌ها
            </a>

        </div>

    </div>

</div>