    <!-- نظرات کاربران -->
    <section class="comments section" id="comments">

        <div class="section-container">

            <div class="section-heading centered">

                <h2>نظرات کاربران</h2>

                <p>
                    تجربه کاربران از Codino
                </p>

            </div>

            @if (TempData["CommentSuccess"] != null)
            {
                <div class="comment-message success">
                    @TempData["CommentSuccess"]
                </div>
            }

            @if (TempData["CommentError"] != null)
            {
                <div class="comment-message error">
                    @TempData["CommentError"]
                </div>
            }

            @if (displayedComments.Any())
            {
                <div class="comments-grid">

                    @foreach (var comment in displayedComments)
                    {
                        string safeUserName =
                            string.IsNullOrWhiteSpace(comment.UserName)
                                ? "کاربر"
                                : comment.UserName.Trim();

                        string avatarLetter =
                            safeUserName.Length > 0
                                ? safeUserName.Substring(0, 1)
                                : "ک";

                        <article class="comment-card">

                            <div class="comment-top">

                                <div class="comment-avatar">
                                    @avatarLetter
                                </div>

                                <div class="comment-user-info">

                                    <h4>
                                        @safeUserName
                                    </h4>

                                </div>

                            </div>

                            <div class="stars"
                                 aria-label="امتیاز @comment.Rating از 5">

                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= comment.Rating)
                                    {
                                        <span class="star-filled">★</span>
                                    }
                                    else
                                    {
                                        <span class="star-empty">★</span>
                                    }
                                }

                            </div>

                            <p class="comment-text">
                                @comment.Text
                            </p>

                        </article>
                    }

                </div>
            }
            else
            {
                <div class="no-comments">
                    هنوز نظری ثبت نشده است.
                </div>
            }

        </div>

    </section>


    <!-- ثبت نظر -->
    <section class="add-comment section" id="add-comment">

        <div class="section-container">

            <div class="section-heading centered">

                <h2>نظر خودت را ثبت کن</h2>

                <p>
                    تجربه‌ات از Codino را با ما به اشتراک بگذار.
                </p>

            </div>

            @if (!isLoggedIn)
            {
                <div class="login-required">

                    <h3>
                        برای ثبت نظر وارد حساب خود شوید
                    </h3>

                    <a asp-controller="Account"
                       asp-action="Login"
                       class="primary-button">

                        ورود به حساب

                    </a>

                </div>
            }
            else
            {
                <form class="comment-form"
                      id="commentForm"
                      asp-controller="Home"
                      asp-action="CreateComment"
                      method="post"
                      autocomplete="off">

                    @Html.AntiForgeryToken()

                    <div class="rating">

                        <span>
                            امتیاز شما:
                        </span>

                        <div class="rating-stars" id="ratingStars">

                            @for (int i = 1; i <= 5; i++)
                            {
                                <button type="button"
                                        data-rating="@i"
                                        aria-label="امتیاز @i از 5">

                                    ★

                                </button>
                            }

                        </div>

                    </div>

                    <input type="hidden"
                           id="rating"
                           name="rating"
                           value="0" />

                    <textarea id="commentText"
                              name="text"
                              maxlength="500"
                              minlength="1"
                              required
                              autocomplete="off"
                              placeholder="نظر خود را بنویسید..."></textarea>

                    <div class="comment-counter">

                        <span id="commentCounter">0</span>
                        / 500

                    </div>

                    <button type="submit"
                            class="primary-button">

                        ثبت نظر

                    </button>

                </form>
            }

        </div>

    </section>

</main>


