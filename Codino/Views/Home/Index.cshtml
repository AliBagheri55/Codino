@model Codino.Models.HomeViewModel
@using Microsoft.AspNetCore.Http

@{
    ViewData["Title"] = "Codino";

    string? userFullName = Context.Session.GetString("UserFullName");
    string? userId = Context.Session.GetString("UserId");

    bool isLoggedIn =
        !string.IsNullOrWhiteSpace(userId) &&
        !string.IsNullOrWhiteSpace(userFullName);

    var allComments =
        Model?.Comments ??
        new List<Codino.Models.Api.CommentResponse>();

    var displayedComments = allComments
        .Where(x => x.Rating >= 1 && x.Rating <= 5)
        .OrderByDescending(x => x.CreatedAt)
        .Take(2)
        .ToList();

    int goodCommentsCount = allComments.Count(x => x.Rating >= 4);
    int badCommentsCount = allComments.Count(x => x.Rating <= 2);
}

