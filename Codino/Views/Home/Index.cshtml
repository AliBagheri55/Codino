            @if (isLoggedIn)
            {
                <div class="user-menu">

                    <a asp-controller="Account"
                       asp-action="Profile"
                       class="user-name">
                        @userFullName
                    </a>

                    <form asp-controller="Account"
                          asp-action="Logout"
                          method="post">

                        @Html.AntiForgeryToken()

                        <button type="submit"
                                class="logout-button">
                            خروج
                        </button>

                    </form>

                </div>
            }
            else
            {
                <a asp-controller="Account"
                   asp-action="Login"
                   class="login-button">
                    ورود
                </a>

                <a asp-controller="Account"
                   asp-action="Register"
                   class="register-button">
                    ثبت‌نام
                </a>
            }

        </div>

        <!-- دکمه منوی موبایل -->
